# Local PostgreSQL container credentials. Change the password for shared hosts.
APP_ENV=development
POSTGRES_DB=kaogong
POSTGRES_USER=kaogong
POSTGRES_PASSWORD=kaogong

# Use a long random value outside disposable local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
COOKIE_SECURE=false

# auto uses OpenAI when a key exists and the deterministic demo provider otherwise.
PROVIDER_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# OCR selection is independent from PROVIDER_MODE. Leave credentials empty locally.
OCR_PROVIDER=mock
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=
TENCENTCLOUD_OCR_TIMEOUT_SECONDS=30
TENCENTCLOUD_OCR_MAX_CONCURRENCY=2
TENCENTCLOUD_OCR_QUEUE_TIMEOUT_SECONDS=5
TENCENTCLOUD_OCR_MAX_RETRIES=2
OCR_PROCESSING_LEASE_SECONDS=180
OCR_RATE_LIMIT_PER_MINUTE=5
OCR_RATE_LIMIT_PER_HOUR=50
OCR_CORRECTED_IMAGE_MAX_BYTES=10485760
OCR_CORRECTED_IMAGES_MAX_TOTAL_BYTES=10485760
OCR_CROP_MAX_ARTIFACTS=100
OCR_CROP_MAX_TOTAL_PNG_BYTES=10485760

# Fixed in backend code: endpoint=ocr.tencentcloudapi.com,
# UseNewModel=false, EnableImageCrop=true, EnableOnlyDetectBorder=false.

MAX_UPLOAD_BYTES=10485760
UPLOAD_MAX_CONCURRENCY=2
UPLOAD_QUEUE_TIMEOUT_SECONDS=5
UPLOAD_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_HOUR=100
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["*"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
