# Local PostgreSQL container credentials. Change the password for shared hosts.
POSTGRES_DB=kaogong
POSTGRES_USER=kaogong
POSTGRES_PASSWORD=kaogong

# Use a long random value outside disposable local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
COOKIE_SECURE=false

# auto uses OpenAI when a key exists and the deterministic demo provider otherwise.
PROVIDER_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
